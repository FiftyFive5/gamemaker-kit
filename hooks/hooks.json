{
  "description": "Runs the GameMaker project checker after .yy, .yyp or .gml files are written",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_after_write.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
